import { stringify, parse, validate } from "../index.ds"

fn go() {
  let obj = { x: 1, name: "deka" };
  const encoded = match (stringify(obj)) {
    Ok(v) => v,
    Err(e) => "fail-stringify"
  };
  if (encoded != "{\"x\":1,\"name\":\"deka\"}") {
    print("fail-stringify");
    print(encoded);
    return;
  }

  const decoded = match (parse(encoded)) {
    Ok(v) => v,
    Err(e) => "fail-parse"
  };
  const x = match (unsafe { decoded.x }) {
    Ok(v) => v,
    Err(e) => -1
  };
  if (x != 1) {
    print("fail-parse");
    return;
  }

  const bad = match (parse("not json")) {
    Ok(v) => false,
    Err(e) => true
  };
  if (!bad) {
    print("fail-invalid");
    return;
  }

  const okv = match (validate(encoded)) {
    Ok(v) => v,
    Err(e) => false
  };
  const badv = match (validate("{")) {
    Ok(v) => v,
    Err(e) => true
  };
  if (!okv || badv) {
    print("fail-validate");
    return;
  }

  print("ok");
}

go()
