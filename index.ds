// JSON in DekaScript. No host kind: parse is JS, not Rust.
//
// stringify is intentionally unavailable until RFD 43 lands. JSON support is
// moving into the language as toJSON() and parseJSON<T>() methods using the
// static-dispatch model from RFD 40; do not replace it with a dishonest top
// type or another user-declared generic.

export fn parse(text: string) {
  return unsafe { JSON.parse(text) }
}

export fn validate(text: string) {
  return match (parse(text)) {
    Ok(v) => Ok(true),
    Err(e) => Ok(false)
  }
}
